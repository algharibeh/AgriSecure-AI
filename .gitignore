# Raw and downloaded data — never commit (large and/or third-party licensed),
# except the Tümosan recording (CC BY 4.0), which ships as data/tumosan_raw/FIELD_FILES.zip
# with the authors' README; the unpacked .tab files stay untracked
downloads/
*.rar
*.zip
*.gz
*.log.bin
data/*
!data/tumosan_raw/
data/tumosan_raw/*
!data/tumosan_raw/FIELD_FILES.zip
!data/tumosan_raw/README.txt

# Generated dataset blobs (keep schema, datasheet, events + sample in git)
dataset/normal/
dataset/attacked/
dataset/*.parquet
results/*.parquet
# (dataset/events.csv and dataset/SAMPLE_*.csv are small and intentionally tracked)

# Python
.venv/
__pycache__/
*.pyc

# OS / editor
Thumbs.db
.DS_Store

# Phase 2 generated blobs (regenerated by the scripts; results/tiny_model.npz is small and tracked)
results/*.npy
embedded/*.o
embedded/tiny_ids
embedded/tiny_ids.exe

# Reproduction logs written by reproduce.py
results/reproduction_log_*.txt

# Bundled Python (python.org embeddable 3.9.13, unpacked by reproduce.bat on first run)
tools/python/
!tools/python-3.9.13-embed-amd64.zip
